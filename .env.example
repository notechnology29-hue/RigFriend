# Copy to .env.local (local dev) or add in Vercel > Settings > Environment Variables.
# Never put real values in this file: it's committed to git.

# Public site URL (used for canonical links, sitemap and emails)
SITE_URL=https://rigfriend.com

# Supabase (Project settings > API keys)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser. The older name
# NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server only, full database access. The older name
# SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=

# Email via Resend
RESEND_API_KEY=
EMAIL_FROM="Rigfriend <hello@rigfriend.com>"
EMAIL_REPLY_TO=
MAILING_ADDRESS=

# Vercel Cron calls /api/cron/send-emails with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Admin (/admin): password of 12+ characters, secret of 32+ random characters
ADMIN_PASSWORD=
ADMIN_SECRET=
